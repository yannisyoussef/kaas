# Optional local Docker Compose overrides. Defaults are safe for loopback-only development.
POSTGRES_DB=kaas
POSTGRES_USER=kaas
POSTGRES_PASSWORD=kaas-local-only
POSTGRES_PORT=5432
# API configuration when the Spring Boot app runs outside Compose.
KAAS_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/kaas
KAAS_DATABASE_USERNAME=kaas
KAAS_DATABASE_PASSWORD=kaas-local-only
KAAS_OIDC_ISSUER_URI=https://identity.example.test/issuer
KAAS_OIDC_JWK_SET_URI=https://identity.example.test/.well-known/jwks.json
KAAS_OIDC_AUDIENCE=kaas-api
RABBITMQ_DEFAULT_USER=kaas
RABBITMQ_DEFAULT_PASS=kaas-local-only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_ROOT_USER=kaas-local
MINIO_ROOT_PASSWORD=kaas-local-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
